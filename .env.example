# העתיקי את הקובץ ל-.env ומלאי ערכים. הקובץ .env לא עולה ל-GitHub.

# Somee.com – MS SQL Server (החליפי USER, PASSWORD, SERVER, DBNAME)
DB_CONNECTION_STRING=mssql+pyodbc://USER:PASSWORD@SERVER.mssql.somee.com/DBNAME?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

FRONTEND_ORIGIN=http://localhost:4200
JWT_SECRET=change-me

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3

CHROMA_HOST=localhost
CHROMA_PORT=8000

TAVILY_API_KEY=
GMAIL_MCP_CREDENTIALS_PATH=./secrets/gmail.json
UPLOAD_DIR=./uploads
AGENT_POLL_SECONDS=20
PRICE_ALERT_DEFAULT_PCT=5
